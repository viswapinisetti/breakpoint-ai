# ---------------------------------------------------------------------------
# AI provider. Set ONE of these. Neither is needed to run the student app -
# pre-generated challenges serve fully offline.
# ---------------------------------------------------------------------------

# OpenRouter: one key, many vendors (OpenAI-compatible API).
BREAKPOINT_OPENROUTER_API_KEY=

# Anthropic native Messages API (preferred when available - supports adaptive
# thinking, prompt-cache breakpoints and server-side refusal fallbacks).
# ANTHROPIC_API_KEY=

# Provider selection: auto | openrouter | anthropic
# "auto" uses OpenRouter if its key is set, else Anthropic.
# BREAKPOINT_AI_PROVIDER=auto

# --- OpenRouter model routing ---------------------------------------------
# Generation and critique carry the quality bar; debate and evidence run far
# more often per session, so they default to a cheaper model.
# List real options: python -m scripts.check_provider --list anthropic/
# BREAKPOINT_OPENROUTER_GENERATION_MODEL=anthropic/claude-opus-5
# BREAKPOINT_OPENROUTER_CRITIC_MODEL=anthropic/claude-opus-5
# BREAKPOINT_OPENROUTER_DEBATE_MODEL=anthropic/claude-sonnet-5
# BREAKPOINT_OPENROUTER_EVIDENCE_MODEL=anthropic/claude-sonnet-5

# --- Zero-cost preset -------------------------------------------------------
# `openrouter/free` routes to whatever free model is available, so it costs
# nothing and still works when a key's dollar limit is exhausted. Quality is
# lower and varies per call, so expect a lower survival rate through the
# quality funnel - but nothing unvalidated reaches students either way.
# Uncomment all four to run the whole product at zero cost:
# BREAKPOINT_OPENROUTER_GENERATION_MODEL=openrouter/free
# BREAKPOINT_OPENROUTER_CRITIC_MODEL=openrouter/free
# BREAKPOINT_OPENROUTER_DEBATE_MODEL=openrouter/free
# BREAKPOINT_OPENROUTER_EVIDENCE_MODEL=openrouter/free

# --- Anthropic model routing ----------------------------------------------
# BREAKPOINT_GENERATION_MODEL=claude-opus-5
# BREAKPOINT_CRITIC_MODEL=claude-opus-5
# BREAKPOINT_DEBATE_MODEL=claude-opus-5
# BREAKPOINT_EVIDENCE_MODEL=claude-opus-5

# --- Product settings -------------------------------------------------------
# BREAKPOINT_QUALITY_THRESHOLD=7.0
# BREAKPOINT_MAX_AMBIGUITY=0.35
# BREAKPOINT_CORRECT_ARTIFACT_RATIO=0.20
# BREAKPOINT_MAX_DEBATE_TURNS=6
# BREAKPOINT_MAX_GENERATION_BATCH=10
# BREAKPOINT_ADMIN_TOKEN=
